# Chat 构建 / 发包配置模板
#
# 这个文件只用于构建期或发包期变量。
# 这里的变量一旦修改，就需要重新构建；桌面端场景下通常还需要重新发包。
#
# 这些变量不应该作为部署后的日常运行参数去修改。
# 桌面端公开运行期变量也放在这里，因为它们会被编译进静态资源；
# 它们只对桌面包生效，不会改变 Web/standalone 服务的 `.env`。
#
# 使用方式：
# 1. 复制为 `.env.build`
# 2. 按需修改其中的构建参数
# 3. 执行构建或打包脚本

################################################################################
# 构建期配置
# 生效方式：需要重新构建 / 重新发包
################################################################################

# 说明：
# - `BUILD_MODE`
# - `BUILD_APP`
# 这两个变量不再作为 `.env.build` 的手工配置项。
#
# 它们由构建入口自动决定：
# - `bash scripts/package.sh standalone`
# - `bash scripts/package.sh export`
# - `bash scripts/package.sh app`
# - `bash scripts/package.sh app-release`
# - `npm run export`
# - `npm run app:build`
# - `npm run app:build:release`

################################################################################
# 桌面端公开运行期配置
# 生效方式：需要重新构建 / 重新发包
################################################################################

# 这些变量只供桌面构建使用；CI/命令行环境变量优先级最高。
ENABLE_TOOLS=1
ROUTER_BACKEND_URL=http://127.0.0.1:3011
WEBDAV_BACKEND_BASE_URL=http://127.0.0.1:6065
WEBDAV_BACKEND_PREFIX=/dav
WEBDAV_APP_ID=localhost-3020
CENTRAL_UCAN_AUTH_BASE_URL=http://localhost:8100
CENTRAL_UCAN_APP_ID=
CENTRAL_UCAN_REDIRECT_URI=chat://localhost/central-ucan-callback.html

# 是否禁用 chunk 拆分：`0` 关闭，`1` 开启
DISABLE_CHUNK=0

################################################################################
# 桌面端发包签名配置
# 生效方式：需要重新发包
################################################################################

TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PATH=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
